# 平台本地运行端口号
VITE_PORT = 8848

# 本地 eladmin 后端地址（须与 eladmin application.yml 中 server.port 一致）
VITE_API_TARGET = http://localhost:8004

# 是否启用全部本地 mock（建议 false）。为 false 时仍会为「系统管理」演示页提供 mock/system.ts
VITE_USE_MOCK = false

# 开发环境读取配置文件路径
VITE_PUBLIC_PATH = /

# 开发环境路由历史模式（Hash模式传"hash"、HTML5模式传"h5"、Hash模式带base参数传"hash,base参数"、HTML5模式带base参数传"h5,base参数"）
VITE_ROUTER_HISTORY = "hash"

# 报警规则详情：后端已实现 POST /api/alarm-rule-detail 时设为 true，否则不要开（避免控制台 404）
# VITE_ENABLE_ALARM_RULE_DETAIL = true
