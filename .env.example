# 复制为 .env.development 后按需修改（.env* 不进 Git）

# 平台本地运行端口号
VITE_PORT = 8848

# 本地 eladmin 后端地址（须与 application.yml 中 server.port 一致）
VITE_API_TARGET = http://localhost:8004

# 是否启用全部本地 mock（建议 false）
VITE_USE_MOCK = false

# 开发环境读取配置文件路径
VITE_PUBLIC_PATH = /

# Hash 模式传 "hash"，HTML5 传 "h5"
VITE_ROUTER_HISTORY = "hash"

# 是否隐藏首页
VITE_HIDE_HOME = false

# 报警规则详情：后端已实现 POST /api/alarm-rule-detail 时设为 true
# VITE_ENABLE_ALARM_RULE_DETAIL = true
